rules_version = '2';

// Admin = Firebase Auth custom claim `admin: true`
// (see "cloud functions/functions/scripts/setAdmin.js").
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnder5MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Brand logos, Brands/{brandName}.{ext}. The uploadImage Cloud Function makes
    // the file public and creates the Brands doc.
    match /Brands/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true && isImageUnder5MB();
    }

    // Profile pictures, ProfileImage/{uid}/profile.svg
    match /ProfileImage/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder5MB();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
