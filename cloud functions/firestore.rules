rules_version = '2';

// Pattern: each user writes only under their own uid. Public collections
// (Coupons, SocialCoupons) and the like/dislike counters are written by
// Cloud Functions (Admin SDK, which bypasses these rules) or by admins.
// Admin = Firebase Auth custom claim `admin: true`
// (see "cloud functions/functions/scripts/setAdmin.js").
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /Users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.userUID == uid;
      allow delete: if false;
    }

    // The owner's copy of each coupon. Cloud Functions mirror these to Coupons / SocialCoupons.
    // Admins can also read, edit and delete it (admin coupon tools); the edit is mirrored the same way.
    match /UserCoupons/{uid}/{couponType}/{couponId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && couponType in ['Coupons', 'SocialCoupons']
        && request.resource.data.userID == uid
        && request.resource.data.likes == 0
        && request.resource.data.dislikes == 0
        && !request.resource.data.keys().hasAny(['lastWorkedAt', 'lastFailedAt', 'copies']);
      // Owners (and admins) can edit a coupon but not its counters, "last worked" times or owner.
      allow update: if (isOwner(uid) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'dislikes', 'lastWorkedAt', 'lastFailedAt', 'copies', 'userID']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /Coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /SocialCoupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /UserVotes/{uid}/{voteType}/{couponId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && voteType in ['likes', 'dislikes'];
    }

    // UserCopies/{uid}/coupons/{couponId}: the user copied this code. One per person per coupon, so
    // copying again doesn't count again. A Cloud Function counts it on the coupon and in SharerStats.
    match /UserCopies/{uid}/coupons/{couponId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['copiedAt'])
        && request.resource.data.copiedAt == request.time;
      allow update, delete: if false;
    }

    // SharerStats/{uid}: points and impact numbers for the leaderboard. Written only by Cloud Functions.
    match /SharerStats/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /WishList/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /Brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Category/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Which notifications the user has already seen: { seen: { [notificationKey]: true } }.
    // The notifications themselves are worked out in the browser (saved coupons expiring soon, open reports).
    match /notifications/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['seen'])
        && request.resource.data.seen is map
        && request.resource.data.seen.size() <= 200;
    }

    // Reports/{couponId}_{reporterUid}: one report per user per coupon. Only admins can list or
    // delete them; a user can only check whether their own report exists.
    match /Reports/{reportId} {
      allow get: if isAdmin()
        || (signedIn() && reportId.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$'));
      allow list, delete: if isAdmin();
      allow create: if signedIn()
        && reportId == request.resource.data.couponID + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['couponID', 'couponType', 'reason', 'details', 'reporterUID', 'createdAt'])
        && request.resource.data.reporterUID == request.auth.uid
        && request.resource.data.couponType in ['coupon', 'socialCoupon']
        && request.resource.data.reason in ['not-working', 'expired', 'spam', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
