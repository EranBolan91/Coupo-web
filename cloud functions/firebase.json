{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR/../frontend\" run build -- --outDir \"$PROJECT_DIR/public\" --emptyOutDir"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/coupons/*",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/social/*",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/store/*",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/stores",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/categories",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/categories/*",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "/robots.txt",
        "function": {
          "functionId": "couponPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
